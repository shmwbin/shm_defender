<Window x:Class="DefenderGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DefenderGuard - Windows Security Suite"
        Height="700" Width="1080"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="DefenderGuard" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Microsoft Defender UI" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#1E293B" CornerRadius="8" Margin="12" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="SidebarEngineText" Text="Engine: Checking..." Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SidebarSignatureText" Text="Definitions: --" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,8,0,0">
                    <Button Content="🛡️  Dashboard" Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click"/>
                    <Button Content="🔍  Virus &amp; Threat Scan" Style="{StaticResource NavButtonStyle}" Click="NavScan_Click"/>
                    <Button Content="⚙️  Protection Controls" Style="{StaticResource NavButtonStyle}" Click="NavProtection_Click"/>
                    <Button Content="📋  Threat History" Style="{StaticResource NavButtonStyle}" Click="NavThreats_Click"/>
                    <Button Content="🔄  Updates &amp; Firewall" Style="{StaticResource NavButtonStyle}" Click="NavUpdates_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Top Status Banner -->
            <Border x:Name="StatusBanner" Grid.Row="0" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StatusBadge" Width="54" Height="54" CornerRadius="27" Background="#10B981" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="StatusIcon" Text="✓" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Checking Windows Defender Status..." FontSize="20" FontWeight="Bold" Foreground="#065F46"/>
                        <TextBlock x:Name="StatusSubtitle" Text="Loading protection metrics..." FontSize="13" Foreground="#047857" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnQuickScanTop" Content="Quick Scan" Style="{StaticResource ActionButtonStyle}" Background="#059669" Margin="0,0,8,0" Click="QuickScan_Click"/>
                        <Button Content="↻ Refresh" Style="{StaticResource ActionButtonStyle}" Background="#334155" Click="RefreshStatus_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab Views -->
            <Grid Grid.Row="1">
                <!-- 1. Dashboard View -->
                <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="Security Overview" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Real-Time Protection" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CardRealtimeValue" Text="--" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                                    <TextBlock Text="Monitors files &amp; apps continuously" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="10" Padding="16" Margin="5,0,5,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Behavior &amp; Cloud" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CardBehaviorValue" Text="--" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                                    <TextBlock Text="Detects suspicious ransomware &amp; scripts" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="10" Padding="16" Margin="10,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Tamper Protection" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CardTamperValue" Text="--" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                                    <TextBlock Text="Prevents unauthorized security edits" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2">
                            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Virus Definitions &amp; Age" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="CardSignatureDetails" Text="Loading..." FontSize="12" Foreground="#475569" Margin="0,8,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Update Definitions Now" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Click="UpdateSignatures_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Last Scan Summary" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="CardScanDetails" Text="Loading..." FontSize="12" Foreground="#475569" Margin="0,8,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Open Windows Security" Style="{StaticResource ActionButtonStyle}" Background="#475569" HorizontalAlignment="Left" Click="OpenNativeSecurity_Click"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Scan View -->
                <StackPanel x:Name="ViewScan" Visibility="Collapsed">
                    <TextBlock Text="Virus &amp; Threat Scans" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Quick Scan" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Checks common folders where threats hide (Startup, Registry, System)." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button Content="Start Quick Scan" Style="{StaticResource ActionButtonStyle}" Background="#059669" Click="QuickScan_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="18" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖥️ Full Scan" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Deep-scans every file and running program across all drives. May take longer." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button Content="Start Full Scan" Style="{StaticResource ActionButtonStyle}" Click="FullScan_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="18" Margin="10,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📁 Custom Scan" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Pick any specific folder or USB drive to scan immediately." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button Content="Select Folder &amp; Scan" Style="{StaticResource ActionButtonStyle}" Background="#7C3AED" Click="CustomScan_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- 3. Protection Controls View -->
                <StackPanel x:Name="ViewProtection" Visibility="Collapsed">
                    <TextBlock Text="Protection Controls" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Real-Time Protection" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Blocks malware before it runs. Note: Tamper Protection may lock changes." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Enable" Style="{StaticResource ActionButtonStyle}" Background="#059669" Margin="0,0,8,0" Click="EnableRealtime_Click"/>
                                    <Button Content="Disable" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="DisableRealtime_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Cloud-Delivered Protection (MAPS)" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Sends unknown file metadata to Microsoft Cloud for instant blocking." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Enable Advanced Cloud" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="EnableCloud_Click"/>
                            </DockPanel>

                            <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="PUA (Potentially Unwanted App) Blocking" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Blocks adware, bundleware, and unwanted installers." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Enable PUA Protection" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="EnablePua_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Threat History View -->
                <DockPanel x:Name="ViewThreats" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Detected Threats &amp; History" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="Load Threat History" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="LoadThreats_Click"/>
                    </DockPanel>
                    <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBox x:Name="ThreatsTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontFamily="Consolas" FontSize="12" Text="Click 'Load Threat History' to inspect recent Microsoft Defender detections."/>
                    </Border>
                </DockPanel>

                <!-- 5. Updates & Firewall View -->
                <StackPanel x:Name="ViewUpdates" Visibility="Collapsed">
                    <TextBlock Text="Updates &amp; Network Firewall" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="FirewallStatusText" Text="Firewall Status: Click Check Firewall to inspect Domain, Private, and Public profiles." FontSize="13" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Check Firewall Profiles" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="CheckFirewall_Click"/>
                                <Button Content="Update Virus Definitions" Style="{StaticResource ActionButtonStyle}" Background="#059669" Click="UpdateSignatures_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Activity Log Console -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Activity Log" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="LogConsole" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="[Ready] DefenderGuard initialized."/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
